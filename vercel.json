{
    "version": 2,
    "builds": [
        {
            "src": "green_harvest_backend/wsgi.py",
            "use": "@vercel/python",
            "config": {
                "maxLambdaSize": "15mb",
                "runtime": "python3.13",
                "buildCommand": "bash build_files.sh"
            }
        },
        {
            "src": "staticfiles/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/static/(.*)",
            "dest": "/staticfiles/$1",
            "headers": {
                "Cache-Control": "public, max-age=31536000, immutable"
            }
        },
        {
            "src": "/media/(.*)",
            "dest": "green_harvest_backend/wsgi.py"
        },
        {
            "src": "/(.*)",
            "dest": "green_harvest_backend/wsgi.py"
        }
    ]
}